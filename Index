    <!-- JavaScript App Logic -->
    <script>
        // Data Menu
        const menuData = [
            { id: 1, name: "Soto Tangkar Daging", price: 25000, category: "makanan", desc: "Daging sapi pilihan empuk dengan kuah santan bumbu kuning kaya rempah.", popular: true },
            { id: 2, name: "Soto Tangkar Campur", price: 22000, category: "makanan", desc: "Kombinasi daging dan jeroan sapi segar yang disiram kuah gurih hangat.", popular: false },
            { id: 3, name: "Nasi Putih", price: 5000, category: "pelengkap", desc: "Nasi putih hangat porsi pas.", popular: false },
            { id: 4, name: "Es Jeruk Peras", price: 7000, category: "minuman", desc: "Jeruk peras segar alami penawar dahaga.", popular: true },
            { id: 5, name: "Teh Manis (Es / Hangat)", price: 4000, category: "minuman", desc: "Teh seduh harum manis pas.", popular: false },
            { id: 6, name: "Emping / Kerupuk", price: 3000, category: "pelengkap", desc: "Pelengkap renyah untuk santap soto.", popular: false }
        ];

        // State Keranjang
        let cart = {};

        // Render Menu Cards
        function renderMenu(categoryFilter = 'all') {
            const container = document.getElementById('menu-container');
            container.innerHTML = '';

            const filteredMenu = categoryFilter === 'all' 
                ? menuData 
                : menuData.filter(item => item.category === categoryFilter);

            filteredMenu.forEach(item => {
                const qty = cart[item.id] || 0;
                const card = document.createElement('div');
                card.className = "bg-white p-4 rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between hover:border-amber-300 transition-all";
                card.innerHTML = `
                    <div>
                        <div class="flex items-start justify-between gap-2">
                            <h4 class="font-bold text-stone-900 text-sm">${item.name}</h4>
                            ${item.popular ? '<span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap">Favorit</span>' : ''}
                        </div>
                        <p class="text-stone-500 text-xs mt-1 leading-relaxed">${item.desc}</p>
                    </div>
                    <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between">
                        <span class="font-bold text-brand-red text-sm">Rp ${item.price.toLocaleString('id-ID')}</span>
                        <div class="flex items-center gap-2">
                            ${qty > 0 ? `
                                <button onclick="updateQty(${item.id}, -1)" class="w-7 h-7 rounded-lg bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold flex items-center justify-center text-sm">-</button>
                                <span class="text-xs font-bold w-4 text-center">${qty}</span>
                            ` : ''}
                            <button onclick="updateQty(${item.id}, 1)" class="w-7 h-7 rounded-lg bg-brand-orange hover:bg-orange-700 text-white font-bold flex items-center justify-center text-sm shadow-sm">+</button>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Update Quantity
        function updateQty(id, change) {
            const current = cart[id] || 0;
            const updated = current + change;
            
            if (updated <= 0) {
                delete cart[id];
            } else {
                cart[id] = updated;
            }

            renderMenu(document.querySelector('.menu-filter-btn.active').getAttribute('data-cat'));
            renderCart();
        }

        // Render Cart View
        function renderCart() {
            const cartContainer = document.getElementById('cart-items');
            const totalQtyEl = document.getElementById('cart-total-qty');
            const totalPriceEl = document.getElementById('cart-total-price');

            const itemIds = Object.keys(cart);
            if (itemIds.length === 0) {
                cartContainer.innerHTML = `<p class="text-stone-400 text-xs text-center py-8">Belum ada item yang dipilih.<br>Klik tombol + pada menu untuk menambah.</p>`;
                totalQtyEl.textContent = '0 porsi';
                totalPriceEl.textContent = 'Rp 0';
                return;
            }

            cartContainer.innerHTML = '';
            let totalQty = 0;
            let totalPrice = 0;

            itemIds.forEach(id => {
                const item = menuData.find(m => m.id === parseInt(id));
                const qty = cart[id];
                const subtotal = item.price * qty;

                totalQty += qty;
                totalPrice += subtotal;

                const row = document.createElement('div');
                row.className = 'flex items-center justify-between text-xs py-1.5 border-b border-stone-50';
                row.innerHTML = `
                    <div class="flex-1 pr-2">
                        <p class="font-medium text-stone-800">${item.name}</p>
                        <p class="text-[10px] text-stone-400">${qty} x Rp ${item.price.toLocaleString('id-ID')}</p>
                    </div>
                    <span class="font-semibold text-stone-900">Rp ${subtotal.toLocaleString('id-ID')}</span>
                `;
                cartContainer.appendChild(row);
            });

            totalQtyEl.textContent = `${totalQty} porsi`;
            totalPriceEl.textContent = `Rp ${totalPrice.toLocaleString('id-ID')}`;
        }

        // Filter Menu Handler
        function filterMenu(category) {
            document.querySelectorAll('.menu-filter-btn').forEach(btn => {
                if (btn.getAttribute('data-cat') === category) {
                    btn.classList.add('active', 'bg-brand-red', 'text-white');
                    btn.classList.remove('bg-white', 'text-stone-700');
                } else {
                    btn.classList.remove('active', 'bg-brand-red', 'text-white');
                    btn.classList.add('bg-white', 'text-stone-700');
                }
            });
            renderMenu(category);
        }

        // Reset Cart
        function resetCart() {
            cart = {};
            renderMenu(document.querySelector('.menu-filter-btn.active').getAttribute('data-cat'));
            renderCart();
        }

        // Send Order via WhatsApp
        function sendWhatsAppOrder() {
            const itemIds = Object.keys(cart);
            if (itemIds.length === 0) {
                alert('Pilih minimal satu menu terlebih dahulu.');
                return;
            }

            let phoneNumber = "6281200000000"; // Ganti dengan nomor WA Ibu Iis yang asli
            let text = "Halo Soto Tangkar Ibu Iis, saya ingin memesan:\n\n";

            let grandTotal = 0;
            itemIds.forEach(id => {
                const item = menuData.find(m => m.id === parseInt(id));
                const qty = cart[id];
                const subtotal = item.price * qty;
                grandTotal += subtotal;
                text += `• ${item.name} (${qty}x) = Rp ${subtotal.toLocaleString('id-ID')}\n`;
            });

            const note = document.getElementById('order-note').value;
            if (note) {
                text += `\nCatatan: ${note}\n`;
            }

            text += `\nTotal Estimasi: Rp ${grandTotal.toLocaleString('id-ID')}\n`;
            text += `Mohon konfirmasi pesanan dan ketersediaannya. Terima kasih!`;

            const encodedText = encodeURIComponent(text);
            window.open(`[https://wa.me/$](https://wa.me/$){phoneNumber}?text=${encodedText}`, '_blank');
        }

        // Initialize Lucide Icons & Page Load
        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
            renderMenu('all');
        });
    </script>
